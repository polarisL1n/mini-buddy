# DeepSeek 官方 API Key（必需）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# 模型选择（可选，留空则使用代码中的默认值）
# 老模型 deepseek-chat / deepseek-reasoner 将于 2026/07/24 弃用，已切到 v4 系列
#
# 默认按角色分层选模型（工业级 Agent 标配做法）：
#   MODEL_AGENT    = v4-pro    主 Agent 要多步决策 + 反思 + 温柔降级，必须强推理
#   MODEL_PLAN     = v4-pro    任务拆解质量直接影响 Agent 执行，仍用推理模型
#   MODEL_DELEGATE = v4-flash  子 Agent 单一任务，轻量推理足够，省 60%+ 成本
#
# 想全部最高质量：把 MODEL_DELEGATE 也改成 deepseek-v4-pro
# 想极致省钱：把 MODEL_AGENT 也改成 deepseek-v4-flash（不推荐，会损失温柔降级能力）
MODEL_AGENT=deepseek-v4-pro
MODEL_PLAN=deepseek-v4-pro
MODEL_DELEGATE=deepseek-v4-flash

# Tavily 搜索 API Key（可选，不配置则 search tool 自动禁用）
# 申请：https://tavily.com/  免费 1000 次/月
TAVILY_API_KEY=tvly-xxx
