# DeepSeek 官方 API Key（必需）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# 模型选择（可选，留空则使用默认 deepseek-v4-pro）
# 老模型 deepseek-chat / deepseek-reasoner 将于 2026/07/24 弃用
#
# 默认全部 v4-pro：质量优先（Agent / Plan / Sub-agent 都用推理模型）
# 想降本可按需切到 v4-flash：
#   MODEL_PLAN=deepseek-v4-flash      # plan 是简单 JSON 输出
#   MODEL_DELEGATE=deepseek-v4-flash  # 子 agent 简单任务可降级
MODEL_AGENT=deepseek-v4-pro
MODEL_PLAN=deepseek-v4-pro
MODEL_DELEGATE=deepseek-v4-pro

# Tavily 搜索 API Key（可选，不配置则 search tool 自动禁用）
# 申请：https://tavily.com/  免费 1000 次/月
TAVILY_API_KEY=tvly-xxx
